# 네이버 지도 (NAVER Cloud Platform > Maps > Application 등록 → Client ID)
# 비우면 OpenStreetMap 지도로 동작한다. Web 서비스 URL에 도메인을 등록해야 한다(포트·경로 없이 호스트만).
NEXT_PUBLIC_NAVER_MAP_KEY_ID=
# 키 파라미터 이름. 신규 Maps 콘솔 키는 ncpKeyId, 예전 AI·NAVER API 키는 ncpClientId
NEXT_PUBLIC_NAVER_MAP_KEY_PARAM=ncpKeyId

# 서버 저장소(공개 피드·인허가 차분). Vercel KV(Upstash)면 아래 둘
KV_REST_API_URL=
KV_REST_API_TOKEN=
